{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyPortal",
  "version": "0.1.0",
  "identifier": "dev.HyPortal.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HyPortal",
        "width": 1040,
        "height": 680,
        "minWidth": 880,
        "minHeight": 580,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
